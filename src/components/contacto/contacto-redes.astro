---
import { obtenerIdioma, traducir } from "../../i18n";
import { enlaceWhatsApp } from "../../data/contacto";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const urlWhatsApp = enlaceWhatsApp(t("Hola, quisiera hacer una consulta sobre Saladas."));
---

<section class="bg-[#F9F6F0] px-5 py-16 text-[#2a1b13] sm:px-8 sm:py-20">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 max-w-2xl">
      <h2 class="mt-3 text-balance text-3xl font-extrabold tracking-tight sm:text-4xl">
        {t("Elegí cómo querés contactarnos")}
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-2xl border border-[#e4d7c1] bg-white p-6 shadow-sm sm:p-8">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-[#eadfc8] text-[#654321]">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
            </svg>
          </span>
          <h3 class="text-xl font-bold sm:text-2xl">{t("Escribinos un correo")}</h3>
        </div>
        <p class="mt-2 leading-relaxed text-[#604b3d]">
          {t("Contanos qué necesitás y te responderemos en cuanto podamos.")}
        </p>
        <a
          href="mailto:contacto@visitsaladas.tur.ar"
          class="mt-5 inline-flex min-h-12 items-center justify-center rounded-full bg-[#FFC107] px-6 text-sm font-bold text-[#2a1b13] transition-colors hover:bg-[#e0a800] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#B34D36]"
        >
          {t("Enviar correo")}
        </a>
      </article>

      <article class="rounded-2xl border border-[#e4d7c1] bg-white p-6 shadow-sm sm:p-8">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-[#e8f5e9] text-[#16833b]">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
              <path d="M12.04 2a9.8 9.8 0 0 0-8.36 14.92L2.4 22l5.2-1.24A9.9 9.9 0 1 0 12.04 2Zm0 17.9h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.09.74.82-3.01-.2-.31a8.1 8.1 0 1 1 6.91 3.89Zm4.44-6.06c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.2-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.46-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.09 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold sm:text-2xl">{t("Escribinos por WhatsApp")}</h3>
        </div>
        <p class="mt-2 leading-relaxed text-[#604b3d]">
          {t("Contanos qué necesitás y te responderemos en cuanto podamos.")}
        </p>
        <a
          href={urlWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-12 items-center justify-center rounded-full bg-[#FFC107] px-6 text-sm font-bold text-[#2a1b13] transition-colors hover:bg-[#e0a800] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#B34D36]"
          aria-label={t("Escribir por WhatsApp al +54 11 2465-3402 (abre en una pestaña nueva)")}
        >
          {t("Enviar mensaje por WhatsApp")}
        </a>
      </article>
    </div>
  </div>
</section>