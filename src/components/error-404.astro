---
import Layout from "../layouts/Layout.astro";
import { localizarRuta, obtenerIdioma, traducir } from "../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const descripcion = t("La página que buscás no existe o cambió de dirección.");
---

<Layout title={t("Página no encontrada | Visit Saladas")} description={descripcion}>
  <main class="grid min-h-[70vh] place-items-center bg-[#F9F6F0] px-5 py-24 text-center text-[#1E3A2F] sm:px-8">
    <div class="mx-auto max-w-xl">
      <p class="text-sm font-extrabold uppercase tracking-[0.2em] text-[#B34D36]">{t("Error 404")}</p>
      <h1 class="mt-4 text-balance text-4xl font-extrabold tracking-tight sm:text-6xl">
        {t("No encontramos esta página.")}
      </h1>
      <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-[#40564A] sm:text-lg">
        {descripcion}
      </p>
      <a
        href={localizarRuta("/", idioma)}
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[#FFC107] px-7 text-sm font-bold text-[#1E3A2F] transition-colors hover:bg-[#e0a800] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#B34D36]"
      >
        {t("Volver al inicio")}
      </a>
    </div>
  </main>
</Layout>
