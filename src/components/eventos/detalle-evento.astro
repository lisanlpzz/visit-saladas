---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Evento } from "../../data/eventos";
import { localizarRuta, traducir, type Idioma } from "../../i18n";

interface Props {
  evento: Evento;
  idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const t = (texto: string) => traducir(texto, idioma);
const fotosDisponibles = import.meta.glob<ImageMetadata>("../../images/eventos/**/*.avif", {
  eager: true,
  import: "default",
});
const prefijoGaleria = `../../images/eventos/${evento.galeria}/`;
const galeria = Object.entries(fotosDisponibles)
  .filter(([ruta]) => ruta.startsWith(prefijoGaleria))
  .sort(([rutaA], [rutaB]) => rutaA.localeCompare(rutaB, "es"))
  .map(([, imagen]) => imagen);

if (galeria.length === 0) {
  throw new Error(`No se encontraron imágenes para la galería "${evento.galeria}" del evento "${evento.slug}".`);
}
---

<main>
  <section class="bg-[#F9F6F0] px-5 pb-12 pt-28 text-[#1E3A2F] sm:px-8 sm:pb-16 sm:pt-36">
    <div class="mx-auto max-w-7xl">
      <a
        href={localizarRuta("/eventos/", idioma)}
        class="inline-flex min-h-10 items-center gap-2 text-sm font-semibold text-[#B34D36] transition-colors hover:text-[#1E3A2F] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#B34D36]"
      >
        <span aria-hidden="true">←</span>
        {t("Volver a todos los eventos")}
      </a>
      <div class="mt-6 grid overflow-hidden rounded-3xl border border-[#1E3A2F]/15 bg-white shadow-[0_18px_48px_-32px_rgba(30,58,47,0.35)] lg:grid-cols-[1.1fr_0.9fr]">
        <div class="relative min-h-64 bg-[#F9F6F0] sm:min-h-96 lg:min-h-[34rem]">
          <button
            type="button"
            data-event-photo
            data-photo-src={evento.portada.src}
            data-photo-alt={evento.alt}
            aria-label={`${t("Ampliar portada de")} ${evento.nombre}`}
            class="group absolute inset-0 h-full w-full cursor-zoom-in focus-visible:outline-4 focus-visible:outline-inset focus-visible:outline-[#B34D36]"
          >
            <Image
              src={evento.portada}
              alt={evento.alt}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
          </button>
        </div>
        <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12">
          <h1 class="mt-3 text-balance text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
            {evento.nombre}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-[#40564A] sm:text-lg">{evento.resumen}</p>
          <dl class="mt-7 grid gap-5 border-t border-[#1E3A2F]/15 pt-6 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-bold">{t("Fecha")}</dt>
              <dd class="mt-1 text-[#40564A]">{evento.fecha}</dd>
            </div>
            <div>
              <dt class="font-bold">{t("Lugar")}</dt>
              <dd class="mt-1 text-[#40564A]">{evento.lugar}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section
    class="bg-white px-5 py-12 text-[#1E3A2F] sm:px-8 sm:py-16"
    aria-labelledby="evento-historia-title"
  >
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-16">
      <div>
        <h2
          id="evento-historia-title"
          class="mt-3 text-balance text-3xl font-extrabold tracking-tight sm:text-4xl"
        >
          {t("Historia")}
        </h2>
      </div>
      <div class="space-y-5 text-base leading-relaxed text-[#40564A] sm:text-lg">
        {evento.descripcion.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </div>
  </section>

  <section
    class="bg-[#F9F6F0] px-5 py-12 text-[#1E3A2F] sm:px-8 sm:py-16"
    aria-labelledby="evento-galeria-title"
  >
    <div class="mx-auto max-w-7xl">
      <div class="mb-7 max-w-2xl">
        <h2
          id="evento-galeria-title"
          class="mt-2 text-balance text-3xl font-extrabold tracking-tight sm:text-4xl"
        >
          {t("Galería del evento")}
        </h2>
        <p class="mt-2 text-sm text-[#40564A]">{galeria.length} {t("fotos")}</p>
      </div>
      <div class="grid auto-rows-[10rem] grid-cols-2 gap-3 sm:auto-rows-[14rem] sm:gap-4 lg:grid-cols-3">
        {galeria.map((imagen, indice) => {
          const alt = `${evento.nombre}: ${t("fotografía")} ${indice + 1}`;
          return (
            <figure class:list={[
              "group overflow-hidden rounded-2xl bg-white",
              indice === 0 && "col-span-2 row-span-2 lg:col-span-2",
            ]}>
              <button
                type="button"
                data-event-photo
                data-photo-src={imagen.src}
                data-photo-alt={alt}
                aria-label={`${t("Ampliar fotografía")} ${indice + 1} ${t("de")} ${evento.nombre}`}
                class="block h-full w-full cursor-zoom-in focus-visible:outline-4 focus-visible:outline-inset focus-visible:outline-[#B34D36]"
              >
                <Image
                  src={imagen}
                  alt={alt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <dialog
    data-event-photo-dialog
    aria-label={`${t("Fotos de")} ${evento.nombre}`}
    class="fixed m-auto max-h-[94dvh] max-w-[min(96vw,80rem)] overflow-visible bg-transparent p-0 text-white backdrop:bg-black/85"
  >
    <div class="relative rounded-2xl bg-[#1E3A2F] p-2 shadow-2xl sm:p-3">
      <button
        type="button"
        data-event-photo-close
        aria-label={t("Cerrar foto ampliada")}
        class="absolute -right-3 -top-3 z-10 grid size-11 place-items-center rounded-full bg-[#FFC107] text-2xl font-bold text-[#1E3A2F] shadow-lg transition hover:bg-[#e0a800] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <span aria-hidden="true">&times;</span>
      </button>
      <img
        data-event-photo-view
        alt=""
        class="block max-h-[88dvh] max-w-[min(92vw,76rem)] rounded-xl object-contain"
      />
      <p data-event-photo-caption class="px-3 pb-1 pt-3 text-center text-sm font-medium text-white/90"></p>
    </div>
  </dialog>
</main>

<script>
  const photoDialog = document.querySelector<HTMLDialogElement>("[data-event-photo-dialog]");
  const enlargedPhoto = photoDialog?.querySelector<HTMLImageElement>("[data-event-photo-view]");
  const photoCaption = photoDialog?.querySelector<HTMLElement>("[data-event-photo-caption]");
  const closePhotoButton = photoDialog?.querySelector<HTMLButtonElement>("[data-event-photo-close]");
  const photoButtons = document.querySelectorAll<HTMLButtonElement>("[data-event-photo]");

  if (!photoDialog || !enlargedPhoto || !photoCaption || !closePhotoButton) {
    console.error("No se pudo inicializar el visor de fotos del evento.");
  } else {
    photoButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const src = button.dataset.photoSrc;
        const alt = button.dataset.photoAlt;
        if (!src || !alt) {
          console.error("No se pudo abrir la foto del evento: faltan sus datos.");
          return;
        }

        enlargedPhoto.src = src;
        enlargedPhoto.alt = alt;
        photoCaption.textContent = alt;
        photoDialog.showModal();
        closePhotoButton.focus();
      });
    });

    closePhotoButton.addEventListener("click", () => photoDialog.close());
    photoDialog.addEventListener("click", (event) => {
      if (event.target === photoDialog) photoDialog.close();
    });
    photoDialog.addEventListener("close", () => {
      enlargedPhoto.removeAttribute("src");
      enlargedPhoto.alt = "";
      photoCaption.textContent = "";
    });
  }
</script>
