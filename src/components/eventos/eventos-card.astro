---
import { Image } from "astro:assets";
import { obtenerEventos } from "../../data/eventos";
import { localizarRuta, obtenerIdioma, traducir } from "../../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const eventos = obtenerEventos(idioma);
const eventoInicial = eventos[0];
---

<section data-eventos-lista class="bg-[#F9F6F0] px-5 py-12 text-[#1E3A2F] sm:px-8 sm:py-16" aria-labelledby="eventos-list-title">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 max-w-3xl">
      <h2 id="eventos-list-title" class="mt-2 text-balance text-3xl font-extrabold tracking-[-0.025em] after:mt-3 after:block after:h-[3px] after:w-12 after:rounded-full after:bg-[#FFC107] after:content-[''] sm:text-4xl">
        {t("Tradiciones para vivir todo el año")}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-[#40564A] sm:text-base">
        {t("Conocé las fiestas, celebraciones y propuestas que reúnen a nuestra comunidad.")}
      </p>
    </div>
    <article data-evento-destacado data-etiqueta-enlace={t("Conocer el evento")} class="group mb-12 grid overflow-hidden rounded-[2rem] bg-[#1E3A2F] text-[#F9F6F0] shadow-[0_28px_70px_-38px_rgba(30,58,47,0.55)] md:min-h-[29rem] md:grid-cols-[1.12fr_0.88fr]">
      <a data-enlace-evento-destacado href={localizarRuta(`/evento/${eventoInicial.slug}/`, idioma)} class="relative block min-h-[18rem] overflow-hidden bg-[#1E3A2F] focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#FFC107] sm:min-h-[24rem] md:min-h-full" aria-label={`${t("Conocer el evento")} ${eventoInicial.nombre}`}>
        <Image
          src={eventoInicial.portada}
          alt={eventoInicial.alt}
          data-imagen-evento-destacado
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] motion-reduce:transform-none motion-reduce:transition-none"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#12261E]/75 via-transparent to-[#12261E]/10"></div>
        <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-[#1E3A2F]/70 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-white shadow-lg backdrop-blur-sm sm:left-7 sm:top-7">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-[#FFC107] opacity-60 motion-reduce:animate-none"></span>
            <span class="relative inline-flex size-2 rounded-full bg-[#FFC107]"></span>
          </span>
          {t("Próximo evento")}
        </span>
      </a>
      <div class="relative flex flex-col justify-center overflow-hidden px-6 py-8 sm:px-9 sm:py-10 lg:px-12 lg:py-12">
        <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 size-64 rounded-full border border-[#FFC107]/10"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-14 size-44 rounded-full border border-[#FFC107]/10"></div>
        <h3 class="mt-4 text-balance text-3xl font-extrabold leading-[1.08] tracking-tight sm:text-4xl lg:text-[2.65rem]">
          <span data-nombre-evento-destacado>{eventoInicial.nombre}</span>
        </h3>
        <p data-resumen-evento-destacado class="mt-4 max-w-lg text-sm leading-relaxed text-[#F9F6F0]/80 sm:text-base">{eventoInicial.resumen}</p>
        <dl class="mt-7 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4">
            <dt class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.13em] text-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-none stroke-current" stroke-width="1.6">
                <rect x="2.75" y="4.25" width="14.5" height="13" rx="2"></rect>
                <path stroke-linecap="round" d="M6.25 2.75v3M13.75 2.75v3M3 8h14"></path>
              </svg>
              {t("Fecha")}
            </dt>
            <dd data-fecha-evento-destacado class="mt-2 text-sm font-semibold leading-snug text-[#F9F6F0]">{eventoInicial.fecha}</dd>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4">
            <dt class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.13em] text-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-none stroke-current" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.25 8.25c0 4.25-6.25 9-6.25 9s-6.25-4.75-6.25-9a6.25 6.25 0 1 1 12.5 0Z"></path>
                <circle cx="10" cy="8" r="2"></circle>
              </svg>
              {t("Lugar")}
            </dt>
            <dd data-lugar-evento-destacado class="mt-2 text-sm font-semibold leading-snug text-[#F9F6F0]">{eventoInicial.lugar}</dd>
          </div>
        </dl>
        <a
          data-enlace-evento-destacado
          href={localizarRuta(`/evento/${eventoInicial.slug}/`, idioma)}
          class="mt-7 inline-flex min-h-12 items-center justify-center gap-3 self-start rounded-full bg-[#FFC107] px-6 text-sm font-bold text-[#1E3A2F] transition-all hover:-translate-y-0.5 hover:gap-4 hover:bg-[#e0a800] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#B34D36]"
        >
          {t("Descubrí el evento")}
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-none stroke-current" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 10h12m-5-5 5 5-5 5"></path>
          </svg>
        </a>
      </div>
    </article>

    <h3 class="mb-5 text-xl font-bold tracking-tight after:mt-3 after:block after:h-[3px] after:w-10 after:rounded-full after:bg-[#FFC107] after:content-[''] sm:text-2xl">{t("Más eventos para descubrir")}</h3>
    <div class="grid items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {eventos.map((evento) => (
        <article
          data-tarjeta-evento
          data-fecha-iso={evento.fechaISO ?? ""}
          data-nombre={evento.nombre}
          data-resumen={evento.resumen}
          data-fecha={evento.fecha}
          data-lugar={evento.lugar}
          class:list={[
            "group flex h-full flex-col overflow-hidden rounded-3xl border border-[#1E3A2F]/15 bg-white shadow-[0_14px_38px_-28px_rgba(30,58,47,0.35)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_48px_-28px_rgba(30,58,47,0.4)] motion-reduce:transform-none motion-reduce:transition-none",
            evento.slug === eventoInicial.slug && "hidden",
          ]}
        >
          <a href={localizarRuta(`/evento/${evento.slug}/`, idioma)} class="relative block aspect-[16/10] w-full shrink-0 overflow-hidden bg-[#F9F6F0]" aria-label={`${t("Conocer el evento")} ${evento.nombre}`}>
            <Image
              src={evento.portada}
              alt={evento.alt}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <h4 class="mt-2 text-xl font-bold leading-snug tracking-tight">{evento.nombre}</h4>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[#40564A]">{evento.resumen}</p>
            <dl class="mt-5 border-t border-[#1E3A2F]/15 pt-4 text-sm">
              <div>
                <dt class="font-bold text-[#1E3A2F]">{t("Fecha")}</dt>
                <dd class="mt-1 text-[#40564A]">{evento.fecha}</dd>
              </div>
              <div class="mt-3">
                <dt class="font-bold text-[#1E3A2F]">{t("Lugar")}</dt>
                <dd class="mt-1 text-[#40564A]">{evento.lugar}</dd>
              </div>
            </dl>
            <a
              href={localizarRuta(`/evento/${evento.slug}/`, idioma)}
              class="mt-5 inline-flex min-h-11 items-center gap-2 self-start rounded-full border border-[#B34D36]/45 px-5 text-sm font-bold text-[#B34D36] transition-colors hover:bg-[#B34D36]/10 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#B34D36]"
            >
              {t("Conocer el evento")}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const listaEventos = document.querySelector<HTMLElement>("[data-eventos-lista]")!;
  const eventoDestacado = listaEventos.querySelector<HTMLElement>("[data-evento-destacado]")!;
  const tarjetas = Array.from(listaEventos.querySelectorAll<HTMLElement>("[data-tarjeta-evento]"));

  const actualizarEventoDestacado = () => {
    const ahora = new Date();
    const hoy = [
      ahora.getFullYear(),
      String(ahora.getMonth() + 1).padStart(2, "0"),
      String(ahora.getDate()).padStart(2, "0"),
    ].join("-");
    const eventoProximo =
      tarjetas
        .filter((tarjeta) => tarjeta.dataset.fechaIso && tarjeta.dataset.fechaIso >= hoy)
        .sort((a, b) => a.dataset.fechaIso!.localeCompare(b.dataset.fechaIso!))[0] ?? tarjetas[0]!;

    eventoDestacado.querySelector("[data-nombre-evento-destacado]")!.textContent = eventoProximo.dataset.nombre!;
    eventoDestacado.querySelector("[data-resumen-evento-destacado]")!.textContent = eventoProximo.dataset.resumen!;
    eventoDestacado.querySelector("[data-fecha-evento-destacado]")!.textContent = eventoProximo.dataset.fecha!;
    eventoDestacado.querySelector("[data-lugar-evento-destacado]")!.textContent = eventoProximo.dataset.lugar!;

    const enlaceTarjeta = eventoProximo.querySelector<HTMLAnchorElement>("a")!;
    const imagenTarjeta = eventoProximo.querySelector<HTMLImageElement>("img")!;
    eventoDestacado.querySelectorAll<HTMLAnchorElement>("[data-enlace-evento-destacado]").forEach((enlace) => {
      enlace.href = enlaceTarjeta.href;
    });
    eventoDestacado
      .querySelector<HTMLAnchorElement>("[data-enlace-evento-destacado][aria-label]")!
      .setAttribute("aria-label", `${eventoDestacado.dataset.etiquetaEnlace} ${eventoProximo.dataset.nombre}`);

    const imagenDestacada =
      eventoDestacado.querySelector<HTMLImageElement>("[data-imagen-evento-destacado]")!;
    imagenDestacada.src = imagenTarjeta.src;
    imagenDestacada.srcset = imagenTarjeta.srcset;
    imagenDestacada.sizes = imagenTarjeta.sizes;
    imagenDestacada.alt = imagenTarjeta.alt;

    tarjetas.forEach((tarjeta) => {
      tarjeta.classList.toggle("hidden", tarjeta === eventoProximo);
    });
  };

  const actualizarAlCambiarElDia = () => {
    const ahora = new Date();
    const medianoche = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate() + 1);
    window.setTimeout(() => {
      actualizarEventoDestacado();
      actualizarAlCambiarElDia();
    }, medianoche.getTime() - ahora.getTime());
  };

  actualizarEventoDestacado();
  actualizarAlCambiarElDia();
</script>
