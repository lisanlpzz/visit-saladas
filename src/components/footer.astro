---
import { localizarRuta, obtenerIdioma, traducir } from "../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
---

<footer class="bg-black px-5 pb-24 pt-12 text-[#f5ecd8] sm:px-8 sm:py-14">
  <div class="mx-auto grid max-w-7xl gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    <div class="max-w-sm">
      <a href={localizarRuta("/#portada", idioma)} aria-label={t("Visit Saladas, inicio")} class="inline-flex">
        <img src="/logo.webp" alt="Visit Saladas" class="h-16 w-auto" loading="lazy" decoding="async" />
      </a>
      <p class="mt-5 text-sm leading-relaxed text-[#f5ecd8]/65">
        {t("Somos un proyecto independiente que busca mostrar lo mejor de Saladas al mundo.")}
      </p>
      <div class="mt-6">
        <ul class="mt-3 flex flex-wrap gap-3">
          <li>
            <a href="https://www.instagram.com/visitsaladas/" target="_blank" rel="noopener noreferrer" aria-label={t("Visit Saladas en Instagram")} class="grid size-11 place-items-center rounded-full border border-[#f5ecd8]/15 text-[#f5ecd8]/75 transition-colors hover:border-[#FFC107]/60 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.7">
                <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="fill-current stroke-none" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/people/Visit-Saladas/61567853420030/" target="_blank" rel="noopener noreferrer" aria-label={t("Visit Saladas en Facebook")} class="grid size-11 place-items-center rounded-full border border-[#f5ecd8]/15 text-[#f5ecd8]/75 transition-colors hover:border-[#FFC107]/60 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
                <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.1H7v3.2h2.8V21h3.7Z" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.tiktok.com/@visitsaladas" target="_blank" rel="noopener noreferrer" aria-label={t("Visit Saladas en TikTok")} class="grid size-11 place-items-center rounded-full border border-[#f5ecd8]/15 text-[#f5ecd8]/75 transition-colors hover:border-[#FFC107]/60 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
                <path d="M19.6 7.2a6.7 6.7 0 0 1-4.1-1.4v8.1a6.1 6.1 0 1 1-5.3-6.1v3.3a2.9 2.9 0 1 0 2.1 2.8V2.5h3.2c.2 2.2 1.8 4 4.1 4.3v.4Z" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@visitsaladas" target="_blank" rel="noopener noreferrer" aria-label={t("Visit Saladas en YouTube")} class="grid size-11 place-items-center rounded-full border border-[#f5ecd8]/15 text-[#f5ecd8]/75 transition-colors hover:border-[#FFC107]/60 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FFC107]">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <nav aria-label={t("Secciones del sitio")}>
      <h2 class="text-sm font-semibold">{t("Explorá")}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm text-[#f5ecd8]/65">
        <li><a href={localizarRuta("/", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Inicio")}</a></li>
        <li><a href={localizarRuta("/galeria", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Galería")}</a></li>
        <li><a href={localizarRuta("/mapa", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Mapa")}</a></li>
        <li><a href={localizarRuta("/eventos", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Eventos")}</a></li>
        <li><a href={localizarRuta("/nosotros", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Nosotros")}</a></li>
        <li><a href={localizarRuta("/contacto", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Contacto")}</a></li>
        <li><a href={localizarRuta("/transporte", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Transporte")}</a></li>
        <li><a href={localizarRuta("/alojamientos", idioma)} class="transition-colors hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-[#FFC107]">{t("Alojamientos")}</a></li>
      </ul>
    </nav>

  </div>

  <div class="mx-auto mt-10 max-w-7xl border-t border-[#f5ecd8]/10 pt-5 text-center text-xs text-[#f5ecd8]/50">
    <p class="flex flex-wrap gap-x-1">
      <span>© 2026 Visit Saladas. {t("Desarrollado por")}</span>
      <a
        href="https://www.instagram.com/lisanlpz"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-[#f5ecd8]/75 underline decoration-[#f5ecd8]/25 underline-offset-4 transition-colors hover:text-[#FFC107] hover:decoration-[#FFC107] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFC107]"
      >
        Lisandro Lopez
      </a>
    </p>
  </div>
</footer>