---
import { Image } from "astro:assets";
import garzaCostanera from "../../images/garza.webp";
import { obtenerIdioma, traducir } from "../../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
---

<section
  class="relative isolate flex min-h-[min(78svh,48rem)] items-center overflow-hidden bg-[#1E3A2F] px-5 py-24 text-[#F9F6F0] sm:px-8"
  aria-labelledby="hero-galeria-title"
>
  <Image
    src={garzaCostanera}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover object-center blur-[1px] brightness-[0.58]"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(18,38,30,0.78)_0%,rgba(18,38,30,0.57)_48%,rgba(18,38,30,0.2)_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#12261E]/55 via-transparent to-[#12261E]/15"></div>

  <div class="mx-auto w-full max-w-7xl">
    <div class="max-w-3xl">
    <h1
      id="hero-galeria-title"
      class="max-w-[12ch] text-balance text-[clamp(3rem,8vw,6.5rem)] font-extrabold leading-[0.96] tracking-[-0.04em]"
    >
      {t("Un recorrido visual por la ciudad de Saladas")}
    </h1>
    <p class="mt-5 max-w-2xl text-balance text-base leading-relaxed text-[#F9F6F0]/85 sm:text-xl sm:leading-relaxed">
      {t("Saladas se vive, pero también se contempla. En esta galería reunimos postales de nuestra historia, paisajes, naturaleza y cultura.")}
    </p>
    </div>
  </div>
</section>