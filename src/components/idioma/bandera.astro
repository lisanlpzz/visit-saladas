---
import type { Idioma } from "../../i18n";

interface Props {
  codigo: Idioma;
}

const { codigo } = Astro.props;
---

<svg viewBox="0 0 24 16" class="h-4 w-6 shrink-0 overflow-hidden rounded-sm shadow-sm" aria-hidden="true">
  {codigo === "es" && (
    <>
      <rect width="24" height="16" fill="#75AADB" />
      <rect y="5.33" width="24" height="5.34" fill="white" />
      <circle cx="12" cy="8" r="1.35" fill="#F6B40E" />
    </>
  )}
  {codigo === "en" && (
    <>
      <rect width="24" height="16" fill="#B22234" />
      <path d="M0 1.23h24M0 3.69h24M0 6.15h24M0 8.61h24M0 11.07h24M0 13.53h24M0 15.99h24" stroke="white" stroke-width="1.23" />
      <rect width="10.2" height="8.6" fill="#3C3B6E" />
      <path d="m1.2 1.4.3.7.7.1-.5.5.1.7-.6-.4-.6.4.1-.7-.5-.5.7-.1zM4 1.4l.3.7.7.1-.5.5.1.7-.6-.4-.6.4.1-.7-.5-.5.7-.1zM6.8 1.4l.3.7.7.1-.5.5.1.7-.6-.4-.6.4.1-.7-.5-.5.7-.1zM2.6 4l.3.7.7.1-.5.5.1.7-.6-.4-.6.4.1-.7-.5-.5.7-.1zM5.4 4l.3.7.7.1-.5.5.1.7-.6-.4-.6.4.1-.7-.5-.5.7-.1z" fill="white" />
    </>
  )}
  {codigo === "pt-br" && (
    <>
      <rect width="24" height="16" fill="#009739" />
      <path d="m12 2 9 6-9 6-9-6z" fill="#FFDF00" />
      <circle cx="12" cy="8" r="3.1" fill="#002776" />
      <path d="M9.3 7.5c1.8-.6 3.7-.3 5.3.7" fill="none" stroke="white" stroke-width=".45" />
    </>
  )}
</svg>
