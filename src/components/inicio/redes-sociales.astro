---
import { PhoneCropped } from "../react/phone-section";
import { obtenerIdioma, traducir } from "../../i18n";
import { enlaceWhatsApp } from "../../data/contacto";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const urlWhatsApp = enlaceWhatsApp(t("Hola, quisiera recibir más información sobre Saladas."));
---
<section
  id="redes-sociales"
  class="overflow-hidden border-t border-[#FFC107]/30 bg-[#1E3A2F] px-5 py-24 text-[#f5ecd8] sm:px-8 sm:py-28"
  aria-labelledby="redes-sociales-title"
  data-social-reveal
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 md:grid-cols-[1fr_0.9fr] md:gap-16">
    <div class="relative z-10 max-w-xl md:pb-16">
      <h2
        id="redes-sociales-title"
        class="max-w-[13ch] text-balance text-4xl font-extrabold leading-[1.04] tracking-[-0.045em] sm:text-5xl md:text-[clamp(3rem,5.5vw,5rem)]"
        data-social-item="title"
      >
        {t("Conocé Saladas a través de nuestras redes")}
      </h2>
      <p class="mt-7 flex max-w-md items-center gap-3 text-base leading-relaxed text-[#f5ecd8]/80 sm:text-lg" data-social-item="copy">
        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-[#FFC107]/15 text-[#FFC107]" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-5 fill-current">
            <path d="M7 3.75a1.25 1.25 0 0 1 2.5 0v7.1l.75-.75a1.75 1.75 0 0 1 2.47 0l4.52 4.52a3 3 0 0 1 .88 2.12V19a2 2 0 0 1-2 2h-6.3a3 3 0 0 1-2.12-.88l-3.2-3.2a1.75 1.75 0 0 1 2.47-2.47L7 15.48V3.75Zm10.2-.8a.75.75 0 0 1 1.06 0l1.8 1.8a.75.75 0 1 1-1.06 1.06l-1.8-1.8a.75.75 0 0 1 0-1.06Zm3.05 5.3a.75.75 0 0 1 .75-.75h1.25a.75.75 0 0 1 0 1.5H21a.75.75 0 0 1-.75-.75Zm-6.5-5.5a.75.75 0 0 1 .75-.75h1.25a.75.75 0 0 1 0 1.5H14.5a.75.75 0 0 1-.75-.75Z" />
          </svg>
        </span>
        <span>{t("Tocá")} <strong class="font-bold text-[#FFC107]">{t("«seguir»")}</strong> {t("en el perfil para visitar nuestro Instagram.")}</span>
      </p>
    </div>

    <div class="mx-auto flex w-full max-w-xl flex-col items-center">
      <div class="w-full" data-social-item="phone">
        <PhoneCropped client:visible idioma={idioma} className="w-full max-w-[24rem] sm:max-w-[27rem] lg:max-w-[31rem]" />
      </div>

      <div class="mt-3 w-full max-w-sm text-center">
        <p class="mb-4 text-sm font-medium text-white/70" data-social-item="label">{t("Encontranos también en")}</p>
        <nav aria-label={t("Otras redes sociales")} class="flex justify-center gap-3">
          <a
            class="group inline-flex min-h-12 items-center gap-2 rounded-full border border-white/20 px-4 text-sm font-semibold text-white/90 transition-colors hover:border-[#FFC107]/70 hover:bg-white/10 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFC107]"
            data-social-link
            href="https://www.facebook.com/people/Visit-Saladas/61567853420030/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("Visit Saladas en Facebook")}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
              <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.1H7v3.2h2.8V21h3.7Z" />
            </svg>
            <span>Facebook</span>
          </a>
          <a
            class="group inline-flex min-h-12 items-center gap-2 rounded-full border border-white/20 px-4 text-sm font-semibold text-white/90 transition-colors hover:border-[#FFC107]/70 hover:bg-white/10 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFC107]"
            data-social-link
            href="https://www.tiktok.com/@visitsaladas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("Visit Saladas en TikTok")}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
              <path d="M19.6 7.2a6.7 6.7 0 0 1-4.1-1.4v8.1a6.1 6.1 0 1 1-5.3-6.1v3.3a2.9 2.9 0 1 0 2.1 2.8V2.5h3.2c.2 2.2 1.8 4 4.1 4.3v.4Z" />
            </svg>
            <span>TikTok</span>
          </a>
          <a
            class="group inline-flex min-h-12 items-center gap-2 rounded-full border border-white/20 px-4 text-sm font-semibold text-white/90 transition-colors hover:border-[#FFC107]/70 hover:bg-white/10 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFC107]"
            data-social-link
            href="https://www.youtube.com/@visitsaladas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t("Visit Saladas en YouTube")}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
            </svg>
            <span>YouTube</span>
          </a>
        </nav>
        <a
          class="group mt-5 inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/20 px-4 text-sm font-semibold text-white/90 transition-colors hover:border-[#FFC107]/70 hover:bg-white/10 hover:text-[#FFC107] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#FFC107]"
          data-social-item="whatsapp"
          href={urlWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("Escribir por WhatsApp a Visit Saladas")}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
            <path d="M12.04 2a9.8 9.8 0 0 0-8.36 14.92L2.4 22l5.2-1.24A9.9 9.9 0 1 0 12.04 2Zm0 17.9h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.09.74.82-3.01-.2-.31a8.1 8.1 0 1 1 6.91 3.89Zm4.44-6.06c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.2-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.46-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.09 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" />
          </svg>
          <span>{t("Escribir por WhatsApp")}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const initializeSocialReveal = () => {
    document.querySelectorAll<HTMLElement>("[data-social-reveal]").forEach((section) => {
      if (section.dataset.revealInitialized === "true") return;
      section.dataset.revealInitialized = "true";

      if (!("IntersectionObserver" in window)) {
        section.dataset.socialReveal = "visible";
        return;
      }

      const bounds = section.getBoundingClientRect();
      if (bounds.top < window.innerHeight && bounds.bottom > 0) {
        section.dataset.socialReveal = "visible";
        return;
      }

      section.dataset.socialReveal = "pending";
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        section.dataset.socialReveal = "visible";
        observer.unobserve(section);
      }, { threshold: 0.12 });

      observer.observe(section);
    });
  };

  initializeSocialReveal();
  document.addEventListener("astro:page-load", initializeSocialReveal);
</script>

<style>
  [data-social-reveal="pending"] [data-social-item="phone"] {
    opacity: 0;
    transform: translate3d(0, 3rem, 0);
  }

  [data-social-reveal="visible"] [data-social-item="phone"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 900ms ease-out,
      transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 100ms;
  }

  [data-social-reveal="pending"] [data-social-item="title"],
  [data-social-reveal="pending"] [data-social-item="copy"],
  [data-social-reveal="pending"] [data-social-item="label"],
  [data-social-reveal="pending"] [data-social-link],
  [data-social-reveal="pending"] [data-social-item="whatsapp"] {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
  }

  [data-social-reveal="visible"] [data-social-item="title"],
  [data-social-reveal="visible"] [data-social-item="copy"],
  [data-social-reveal="visible"] [data-social-item="label"],
  [data-social-reveal="visible"] [data-social-link],
  [data-social-reveal="visible"] [data-social-item="whatsapp"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 750ms ease-out,
      transform 850ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-social-reveal="visible"] [data-social-item="title"] {
    transition-delay: 100ms;
  }

  [data-social-reveal="visible"] [data-social-item="copy"] {
    transition-delay: 260ms;
  }

  [data-social-reveal="visible"] [data-social-item="label"] {
    transition-delay: 400ms;
  }

  [data-social-reveal="visible"] [data-social-link]:nth-child(1) {
    transition-delay: 480ms;
  }

  [data-social-reveal="visible"] [data-social-link]:nth-child(2) {
    transition-delay: 580ms;
  }

  [data-social-reveal="visible"] [data-social-link]:nth-child(3) {
    transition-delay: 680ms;
  }

  [data-social-reveal="visible"] [data-social-item="whatsapp"] {
    transition-delay: 800ms;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-social-reveal="pending"] [data-social-item],
    [data-social-reveal="pending"] [data-social-link],
    [data-social-reveal="visible"] [data-social-item],
    [data-social-reveal="visible"] [data-social-link] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>