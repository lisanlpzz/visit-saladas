    );
    background-size: 220% 100%;
    animation: clima-skeleton 1.5s ease-in-out infinite;
    border-radius: 0.75rem;
  }

  [data-widget-clima-raiz][data-clima-cargando="true"] [data-clima-dias] > *,
  [data-widget-clima-raiz][data-clima-cargando="true"] [data-clima-escena-mini] > svg {
    visibility: hidden;
  }

  @keyframes clima-skeleton {
    to {
      background-position: -220% 0;
