  [data-clima-burbuja][data-visible="false"] {
    opacity: 0;
    transform: translateX(0.25rem);
  }

  [data-clima-burbuja][data-visible="true"] {
    opacity: 1;
    transform: translateX(0);
  }

  :global(.clima-rayos) {
    animation: clima-luz-suave 8s ease-in-out infinite;
  }

  :global(.clima-luna) {
    animation: clima-luna 8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.clima-sol-pulso) {
    animation: clima-pulso-sol 7s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.clima-mate) {
    animation: clima-mate-tranquilo 8s ease-in-out infinite;
    transform-box: view-box;
  }

  :global(.clima-estrella) {
    animation: clima-luz-suave 7s ease-in-out infinite;
  }

  :global(.clima-nube) {
    animation: clima-nube 6s ease-in-out infinite;
    transform-box: view-box;
  }

  :global(.clima-bruma) {
    animation: clima-bruma 7s ease-in-out infinite alternate;
  }

  :global(.clima-paraguas) {
    animation: clima-paraguas 7s ease-in-out infinite;
    transform-box: view-box;
  }

  :global(.clima-gotas) {
    animation: clima-gotas 3s ease-in infinite;
  }

  :global(.clima-pronostico-entrada) {
    animation: clima-pronostico-entrada 220ms ease-out both;
  }

  :global(.clima-relampago) {
    animation: clima-relampago 8s linear infinite;
  }

  :global(.clima-vapor) {
    animation: clima-vapor 4.5s ease-in-out infinite;
  }

  :global(.clima-garza) {
    animation: clima-garza 6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: bottom center;
  }

  :global(.clima-garza-vuelo) {
    animation: clima-garza-vuelo 10s ease-in-out infinite;
  }

  @keyframes clima-pulso-sol {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.015); }
  }

  @keyframes clima-mate-tranquilo {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(-1deg); }
  }

  @keyframes clima-luz-suave {
    0%, 100% { opacity: 0.72; }
    50% { opacity: 1; }
  }

  @keyframes clima-nube {
    0%, 100% { transform: translateX(-0.25px); }
    50% { transform: translateX(0.5px); }
  }

  @keyframes clima-bruma {
    from { transform: translateX(-1px); opacity: 0.65; }
    to { transform: translateX(1px); opacity: 0.9; }
  }

  @keyframes clima-paraguas {
    0%, 100% { transform: rotate(-.5deg); }
    50% { transform: rotate(.5deg); }
  }

  @keyframes clima-gotas {
    0% { opacity: 0.4; transform: translateY(-1px); }
    70% { opacity: 0.9; }
    100% { opacity: 0.25; transform: translateY(2px); }
  }

  @keyframes clima-relampago {
    0%, 95%, 100% { opacity: 0.2; }
    96% { opacity: 1; }
    97% { opacity: 0.3; }
  }

