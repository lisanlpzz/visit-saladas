---
import MapaInteractivoReact from "../react/MapaInteractivo";
import { MAPA_ORIGINAL_URL, obtenerDatosMapa } from "../../data/mapa";
import { obtenerIdioma, traducir } from "../../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const { lugares, categorias } = await obtenerDatosMapa();
---

<section
  class="border-t border-[#2a1b13]/10 bg-[#F9F6F0] px-5 py-12 text-[#2a1b13] sm:px-8 sm:py-16"
  aria-labelledby="mapa-interactivo-title"
>
  <div class="mx-auto max-w-7xl">
    <div class="mb-7 flex flex-col gap-5 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="mapa-interactivo-title" class="text-3xl font-bold tracking-tight sm:text-4xl">
          {t("Lugares para descubrir")}
        </h2>
      </div>
      <a
        href={MAPA_ORIGINAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 self-start rounded-full border border-[#B34D36]/35 bg-white/65 px-5 text-sm font-semibold text-[#B34D36] transition-colors hover:border-[#B34D36]/60 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#B34D36] sm:self-auto"
      >
        {t("Ver mapa original")}
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-none stroke-current" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 14 14 6M7 6h7v7" />
        </svg>
      </a>
    </div>

    <MapaInteractivoReact client:load lugares={lugares} categorias={categorias} idioma={idioma} />

    <p class="mt-4 text-xs text-[#2a1b13]/55">
      {t("Mapa turístico de Visit Saladas, integrado desde Google My Maps.")}
    </p>
  </div>
</section>
