---
import TeamCards from "../react/team-cards";
import { obtenerEquipo } from "../../data/equipo";
import { obtenerIdioma, traducir } from "../../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const integrantes = obtenerEquipo(idioma);
---

<section
  class="bg-[#F9F6F0] px-5 py-16 text-[#2a1b13] sm:px-8 sm:py-20"
  aria-labelledby="nosotros-equipo-title"
>
  <div class="mx-auto grid max-w-7xl gap-5 md:grid-cols-[0.8fr_1.2fr] md:items-end md:gap-20">
    <div>
      <h2
        id="nosotros-equipo-title"
        class="text-balance text-3xl font-extrabold tracking-[-0.045em] sm:text-4xl"
      >
        {t("¿Quiénes estamos detrás?")}
      </h2>
    </div>
  </div>
  <div class="mx-auto mt-9 max-w-7xl sm:mt-12">
    <TeamCards client:visible people={integrantes} idioma={idioma} />
  </div>
  <p class="mx-auto mt-6 max-w-2xl text-center text-balance text-base leading-relaxed text-[#2a1b13]/85 sm:text-lg sm:leading-relaxed">
    {t("El proyecto sigue abierto a guías, artistas, emprendedores y talentos locales que quieran sumar su voz.")}
  </p>
</section>