---
import { Image } from "astro:assets";
import terminal from "../../images/terminal.avif";
import { obtenerIdioma, traducir } from "../../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
---

<section
  class="relative isolate flex min-h-[min(78svh,48rem)] items-center overflow-hidden bg-[#1E3A2F] px-5 py-24 text-[#F9F6F0] sm:px-8"
  aria-labelledby="transporte-title"
>
  <Image
    src={terminal}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover object-center brightness-[0.55]"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(18,38,30,0.78)_0%,rgba(18,38,30,0.57)_48%,rgba(18,38,30,0.2)_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#12261E]/55 via-transparent to-[#12261E]/15"></div>

  <div class="mx-auto w-full max-w-7xl">
    <div class="max-w-3xl">
      <h1
        id="transporte-title"
        class="hero-enter max-w-[11ch] text-balance text-[clamp(3rem,8vw,6.5rem)] font-extrabold leading-[0.96] tracking-[-0.055em]"
      >
        {t("Transporte en Saladas")}
      </h1>
      <p style="animation-delay:150ms" class="hero-enter mt-5 max-w-2xl text-balance text-base leading-relaxed text-[#F9F6F0]/85 sm:text-xl sm:leading-relaxed">
        {t("Medios de Transporte hacia y desde Saladas")}
      </p>
    </div>
  </div>
</section>
<style>
  @keyframes hero-enter {
    from { opacity: 0; transform: translate3d(0, 22px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  .hero-enter { animation: hero-enter 750ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @media (prefers-reduced-motion: reduce) { .hero-enter { animation: none; } }
</style>
