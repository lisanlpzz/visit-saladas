---
import { enlaceWhatsApp } from "../data/contacto";
import { obtenerIdioma, traducir } from "../i18n";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (texto: string) => traducir(texto, idioma);
const urlWhatsApp = enlaceWhatsApp(t("Hola, quisiera recibir más información sobre Saladas."));
const mensajesWhatsApp = [
  t("Cualquier cosa, contactanos."),
  t("¿Alguna duda? Escribinos."),
  t("Acá estamos."),
  t("¿Querés información de Saladas?"),
  t("¿Qué opinás de Visit Saladas?"),
  t("Te estamos esperando."),
  t("¿Planeando una visita? Escribinos."),
];
// En la página de inicio el botón se oculta hasta que se supera el "Deslizá para descubrir".
const rutaNormalizada = Astro.url.pathname.replace(/\/?$/, "/");
const esInicio = ["/", "/en/", "/pt-br/"].includes(rutaNormalizada);
---

<a
  href={urlWhatsApp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t("Escribir por WhatsApp a Visit Saladas")}
  title={t("Escribir por WhatsApp")}
  class="group fixed z-40 flex size-13 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_6px_20px_-4px_rgba(0,0,0,0.35)] ring-1 ring-black/5 transition-[scale,translate,box-shadow,opacity,visibility] duration-300 hover:scale-105 hover:shadow-[0_10px_26px_-6px_rgba(0,0,0,0.45)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1E3A2F] active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 print:hidden sm:size-14"
  style="right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));"
  data-whatsapp-flotante
  data-mensajes-whatsapp={JSON.stringify(mensajesWhatsApp)}
  data-oculto={esInicio ? "true" : undefined}
>
  <span aria-hidden="true" data-whatsapp-pulse class="pointer-events-none absolute inset-0 rounded-full border-2 border-[#25D366]/70"></span>
  <span
    aria-hidden="true"
    data-whatsapp-mensaje
    data-visible="false"
    class="pointer-events-none invisible absolute right-full mr-3 w-56 max-w-[calc(100vw-5rem)] rounded-2xl rounded-br-sm border border-[#2a1b13]/10 bg-[#F9F6F0]/95 px-3.5 py-2.5 text-xs font-semibold leading-snug text-[#1E3A2F] shadow-[0_10px_28px_-6px_rgba(42,27,19,0.28)] backdrop-blur-md transition-[opacity,transform,visibility] duration-300 motion-reduce:transition-none sm:w-64"
  >
    <span data-whatsapp-mensaje-texto></span>
  </span>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-7 fill-current sm:size-[1.85rem]">
    <path d="M12.04 2a9.8 9.8 0 0 0-8.36 14.92L2.4 22l5.2-1.24A9.9 9.9 0 1 0 12.04 2Zm0 17.9h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.09.74.82-3.01-.2-.31a8.1 8.1 0 1 1 6.91 3.89Zm4.44-6.06c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.2-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.46-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.09 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" />
  </svg>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-[#1E3A2F] px-3.5 py-2 text-sm font-semibold text-[#F9F6F0] opacity-0 shadow-md transition-[opacity,transform] duration-200 translate-x-1 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 motion-reduce:transition-none lg:block"
  >
    {t("Escribir por WhatsApp")}
  </span>
</a>

<script>
  const botonWhatsApp = document.querySelector<HTMLElement>("[data-whatsapp-flotante]");

  if (botonWhatsApp) {
    const burbuja = botonWhatsApp.querySelector<HTMLElement>("[data-whatsapp-mensaje]");
    const textoBurbuja = botonWhatsApp.querySelector<HTMLElement>("[data-whatsapp-mensaje-texto]");
    const textos: unknown = JSON.parse(botonWhatsApp.dataset.mensajesWhatsapp ?? "[]");
    const opciones = Array.isArray(textos)
      ? [...new Set(textos.filter((texto): texto is string => typeof texto === "string" && texto.length > 0))]
      : [];
    let bolsa: string[] = [];
    let anterior: string | undefined;
    let temporizadorMensaje: number | undefined;
    let temporizadorOcultar: number | undefined;

    const elegirMensaje = () => {
      if (bolsa.length === 0) {
        bolsa = [...opciones];
        for (let indice = bolsa.length - 1; indice > 0; indice--) {
          const destino = Math.floor(Math.random() * (indice + 1));
          [bolsa[indice], bolsa[destino]] = [bolsa[destino], bolsa[indice]];
        }

        if (bolsa.length > 1 && bolsa[bolsa.length - 1] === anterior) {
          [bolsa[0], bolsa[bolsa.length - 1]] = [bolsa[bolsa.length - 1], bolsa[0]];
        }
      }

      const siguiente = bolsa.pop();
      if (siguiente) anterior = siguiente;
      return siguiente;
    };

    const ocultarBurbuja = () => {
      if (burbuja) burbuja.dataset.visible = "false";
    };

    const visible = () =>
      !document.hidden && botonWhatsApp.dataset.oculto !== "true";

    const programarMensaje = (demora: number) => {
      window.clearTimeout(temporizadorMensaje);
      if (!visible() || opciones.length === 0 || !burbuja || !textoBurbuja) return;
      temporizadorMensaje = window.setTimeout(mostrarMensaje, demora);
    };

    const mostrarMensaje = () => {
      if (!visible() || !burbuja || !textoBurbuja) return;

      const burbujaClimaVisible = document.querySelector('[data-clima-burbuja][data-visible="true"]');
      if (botonWhatsApp.matches(":hover, :focus-visible") || burbujaClimaVisible) {
        programarMensaje(20_000);
        return;
      }

      textoBurbuja.textContent = elegirMensaje() ?? "";
      burbuja.dataset.visible = "true";
      window.clearTimeout(temporizadorOcultar);
      temporizadorOcultar = window.setTimeout(ocultarBurbuja, 7_000);
      programarMensaje(30_000);
    };

    let estabaVisible = false;
    const sincronizarBurbuja = () => {
      const estaVisible = visible();
      if (estaVisible === estabaVisible) return;
      estabaVisible = estaVisible;
      window.clearTimeout(temporizadorMensaje);
      window.clearTimeout(temporizadorOcultar);
      if (estaVisible) {
        programarMensaje(12_000);
      } else {
        ocultarBurbuja();
      }
    };

    document.addEventListener("visibilitychange", sincronizarBurbuja);
    window.addEventListener("pageshow", sincronizarBurbuja);

    if (botonWhatsApp.hasAttribute("data-oculto")) {
      const portada = document.getElementById("portada");
      const recorrido = portada?.querySelector<HTMLElement>("[data-scroll-expand-track]");
      const escenario = portada?.querySelector<HTMLElement>("[data-scroll-expand-stage]");
      // Mismo punto en el que aparece la barra de navegación (texto de portada visible).
      const UMBRAL_PROGRESO = 0.6;

      const debeMostrarse = () => {
        if (recorrido && escenario) {
          const distancia = Number(recorrido.dataset.scrollDistance) || 1;
          const progreso = -recorrido.getBoundingClientRect().top / (escenario.clientHeight * distancia);
          return progreso >= UMBRAL_PROGRESO;
        }
        return window.scrollY > window.innerHeight * 0.5;
      };

      let pendiente = false;
      const actualizar = () => {
        pendiente = false;
        botonWhatsApp.dataset.oculto = String(!debeMostrarse());
        sincronizarBurbuja();
      };
      const programarActualizacion = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      };

      window.addEventListener("scroll", programarActualizacion, { passive: true });
      window.addEventListener("resize", programarActualizacion);
      window.addEventListener("pageshow", actualizar);
      actualizar();
    } else {
      sincronizarBurbuja();
    }
  }
</script>

<style>
  [data-whatsapp-mensaje][data-visible="false"] {
    opacity: 0;
    transform: translateX(0.25rem);
    visibility: hidden;
  }

  [data-whatsapp-mensaje][data-visible="true"] {
    opacity: 1;
    transform: translateX(0);
    visibility: visible;
  }

  [data-whatsapp-flotante]:hover [data-whatsapp-mensaje],
  [data-whatsapp-flotante]:focus-visible [data-whatsapp-mensaje] {
    opacity: 0;
    visibility: hidden;
  }

  [data-whatsapp-pulse] {
    animation: whatsapp-pulse 12s ease-out infinite;
  }

  @keyframes whatsapp-pulse {
    0%,
    88%,
    100% {
      opacity: 0;
      transform: scale(1);
    }

    90% {
      opacity: 0.45;
      transform: scale(1.05);
    }

    97% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  [data-whatsapp-flotante][data-oculto="true"] {
    opacity: 0;
    translate: 0 1rem;
    scale: 0.9;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp-pulse] {
      animation: none;
    }

    [data-whatsapp-flotante][data-oculto="true"] {
      translate: none;
      scale: none;
    }
  }
</style>
